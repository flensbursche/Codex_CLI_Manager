{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Manager",
  "version": "0.1.0",
  "identifier": "de.flensbursche.codex-session-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Session Manager",
        "width": 1380,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "backgroundColor": "#090a0c"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
